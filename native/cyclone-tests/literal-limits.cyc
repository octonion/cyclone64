#include "cyclone/library/std/core.h"
using Core;
extern "C" int abi_literal_values(unsigned long, unsigned long, long, long,
                                  unsigned long long, long long);
int main(int argc, string_t ?argv) {
  if (sizeof(1L) != 8 || sizeof(1UL) != 8 || sizeof(1lu) != 8) return 1;
  if (sizeof(2147483648) != 8 || sizeof(4294967295U) != 4) return 2;
  if (sizeof(0xffffffff) != 4 || sizeof(0x100000000) != 8) return 3;
  unsigned long umax = 18446744073709551615UL;
  unsigned long octal = 01777777777777777777777lu;
  long smax = 9223372036854775807L;
  long smin = -9223372036854775807L - 1L;
  unsigned long long llmax = 0xffffffffffffffffLLU;
  long long llmin = -9223372036854775807LL - 1LL;
  if (!abi_literal_values(umax, octal, smax, smin, llmax, llmin)) return 4;
  if (0LL != 0 || 0ULL != 0 || 0L != 0 || 0UL != 0) return 5;
  if (-1L >= 0 || -1LL >= 0 || ~0L >= 0 || ~0LL >= 0) return 6;
  if (-1UL != umax || -1ULL != llmax) return 7;
  return 0;
}
