#include "cyclone/library/std/core.h"
using Core;
static int *@zeroterm`r step(int *@zeroterm`r p,unsigned i) { return p+i; }
static long *@zeroterm`r step_long(long *@zeroterm`r p,unsigned i) { return p+i; }
static long *@zeroterm`r advance(long *@zeroterm`r p) { return ++p; }
static long *@zeroterm`r after(long *@zeroterm`r p) { p++; return p; }
int main(int argc,string_t ?argv) {
  region r;
  int ?@zeroterm a=rnew(r) {for i<3:(int)i+1};
  int *@zeroterm p=(int *@zeroterm)a;
  if(*step(p,2)!=3) return 1;
  long big=0x1234567800000000L;
  long ?@zeroterm b=rnew(r) {for i<3:big+(long)i+1};
  long *@zeroterm q=(long *@zeroterm)b;
  if(*step_long(q,2)!=big+3 || *advance(q)!=big+2 || *after(q)!=big+2) return 2;
  try { step_long(q,4); return 3; }
  catch { case &Array_bounds: break; default: return 99; }
  try { b[3]=big; return 4; }
  catch { case &Array_bounds: break; default: return 99; }
  return b[3]==0 ? 0 : 5;
}
