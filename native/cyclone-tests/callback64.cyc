#include "cyclone/library/std/core.h"
using Core;
static `b invoke(`b (@f)(`a), `a x) { return f(x); }
static `b forward(`b (@f)(`a), `a x) { return invoke(f,x); }
static bool same(`b (@f)(`a), `b (@g)(`a)) { return f==g; }
static int increment(int x) { return x+1; }
static int negate(int x) { return -x; }
static unsigned invert(unsigned x) { return ~x; }
static void assign(int @p) { *p=37; }
static void run_action(void (@f)(`a), `a x) { f(x); }
static int @`r identity_pointer(int @`r p) { return p; }
extern "C" unsigned long abi_echo(unsigned long);
int main(int argc, string_t ?argv) {
  if (invoke(increment,2)!=3 || forward(negate,7)!=-7) return 1;
  if (invoke(invert,0U)!=0xffffffffU) return 2;
  if (!same(increment,increment) || same(increment,negate)) return 3;
  int value=0;
  run_action(assign,&value);
  if (value!=37 || invoke(identity_pointer,&value)!=&value) return 4;
  if (invoke(abi_echo,0x123456789abcdef0UL)!=0x123456789abcdef0UL) return 5;
  return 0;
}
